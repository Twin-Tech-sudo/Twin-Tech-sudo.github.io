// Cloudflare Workers static-assets hosting for the built Astro site (dist/).
// Deployed by .github/workflows/deploy.yml when the DEPLOY_TARGET repo variable is "cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twin-tech-sudo",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Once the domain is on Cloudflare, add:
  // "routes": [
  //   { "pattern": "www.twintechsudo.com", "custom_domain": true },
  //   { "pattern": "twintechsudo.com", "custom_domain": true }
  // ]
}
