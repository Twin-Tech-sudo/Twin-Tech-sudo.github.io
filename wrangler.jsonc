// Cloudflare Workers static-assets hosting for the built Astro site (dist/).
// Deployed by .github/workflows/deploy.yml when the DEPLOY_TARGET repo variable is "cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boqextract",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "www.boqextract.com", "custom_domain": true },
    { "pattern": "boqextract.com", "custom_domain": true }
  ]
}
