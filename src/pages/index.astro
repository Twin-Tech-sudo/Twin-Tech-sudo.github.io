---
import ProductLayout from '../layouts/ProductLayout.astro'
import HeroVisual from '../components/HeroVisual.astro'
import { steps, readsList, formats, audiences, locales, coverage, coverageCounts, readerCount } from '../data/product'

const showcase = ['08-010', '10-030', '10-010', '09-010', '09-020', '11-030', '12-070', '13-020']
const showcaseSections = coverage.flatMap(group => group.sections).filter(section => showcase.includes(section.code))
const pct = (n: number) => `${(n / coverageCounts.total) * 100}%`
---
<ProductLayout>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">Evidence-linked quantity takeoff</span>
        <h1>The whole tender pack, measured. <em>Every line traced to source.</em></h1>
        <p class="lede">BOQ Extract reads drawings, schedules and specifications, then drafts an NRM2-structured bill of quantities. Every quantity links back to the sheet and mark it came from, so your surveyors review evidence instead of starting from a blank sheet.</p>
        <div class="hero-actions">
          <a class="btn btn-acid" href="/pilot/#apply">Join the pilot programme</a>
          <a class="btn btn-ghost" href="/how-it-works/">See how it works</a>
        </div>
        <div class="hero-note"><span>Runs on your own machine</span><span>No paid AI required</span><span>QS stays in control</span></div>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="facts" aria-label="Key facts">
    <div class="wrap facts-grid">
      <div class="fact"><strong>{coverageCounts.total}</strong><span>NRM2 work sections mapped, from preliminaries to external works</span></div>
      <div class="fact"><strong>{readerCount}</strong><span>specialist readers for plans, schedules, elevations and services runs</span></div>
      <div class="fact"><strong>100%</strong><span>local processing: your drawings never leave your computer</span></div>
      <div class="fact"><strong>1:1</strong><span>every draft quantity linked to the drawing evidence behind it</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">The problem</span>
        <h2>Takeoff is still the slowest part of every tender.</h2>
        <p>Tender windows keep shrinking while drawing packs keep growing. Most of a surveyor’s time still goes on counting, scaling and transcribing, not on the judgement only they can provide.</p>
      </div>
      <div class="problem-grid">
        <article><span class="num">01</span><h3>Measured again, by hand</h3><p>Every bidder re-measures the same drawings from scratch. Takeoff tools help you click faster, but someone still has to click every line.</p></article>
        <article><span class="num">02</span><h3>Quantities without a trail</h3><p>A figure in a spreadsheet rarely says where it came from. When a client, main contractor or auditor asks, the only answer is to measure it again.</p></article>
        <article><span class="num">03</span><h3>Scope hiding in the pack</h3><p>The item that costs you the job is usually on the sheet nobody had time to open: a legend, a schedule note, a services layout.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2>From tender pack to reviewable bill, <em>in four steps.</em></h2>
      </div>
      <div class="steps">
        {steps.map(step => <article class="step"><span class="num">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}
      </div>
      <p style="margin-top:36px"><a class="text-link" href="/how-it-works/">Walk through the workflow in detail →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="kicker">Evidence first</span>
        <div class="section-head" style="margin-bottom:28px">
          <h2>Not a black box. A bill you can audit.</h2>
          <p>Every draft line carries its working: which sheet, which grid reference, which schedule row, which rule turned a drawing into a quantity. Click through and see it.</p>
        </div>
        <div class="feature-list">
          <div><span class="ico">↗</span><div><h3>Source on every line</h3><p>Sheet number, location and the reader that measured it, kept with the quantity from first draft to export.</p></div></div>
          <div><span class="ico">?</span><div><h3>Judgement calls raised, not buried</h3><p>Where measurement depends on a QS decision, such as formwork to a slab edge or a deduction for deck troughs, it is put in front of you rather than decided silently.</p></div></div>
          <div><span class="ico">✓</span><div><h3>Reviewer and certifier are different people</h3><p>Built-in roles keep the person who checks a bill separate from the person who signs it off, with every decision recorded.</p></div></div>
        </div>
      </div>
      <div class="evidence-panel" aria-label="Illustration of a bill line's evidence record">
        <div class="ev-head"><b>Line 08-010 / 004</b><span class="chip chip-review">Awaiting review</span></div>
        <dl class="ev-rows">
          <div><dt>Description</dt><dd>Partition type P1, 100 mm metal stud, 2 × 12.5 mm board each side</dd></div>
          <div><dt>Quantity</dt><dd><span class="mono">29.00 m</span></dd></div>
          <div><dt>Source</dt><dd>A-101 Ground floor GA · grid D–F / 3</dd></div>
          <div><dt>Type from</dt><dd>A-024 Partition types · key P1</dd></div>
          <div><dt>Method</dt><dd>Wall centre-line measured between grid intersections at drawing scale</dd></div>
          <div><dt>Raised for QS</dt><dd>Height for m² not shown on plan. Take from section A-301?</dd></div>
        </dl>
        <div class="ev-actions"><span>Accept</span><span>Correct</span><span>Query designer</span></div>
        <p style="color:var(--muted-dark);margin-top:16px;font-size:12px;font-family:var(--mono);letter-spacing:.06em;text-transform:uppercase">Illustrative example</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">What it reads</span>
        <h2>Built for real tender packs, not tidy demos.</h2>
        <p>Packs arrive from several practices, in mixed quality. BOQ Extract classifies every sheet and sends it to readers that understand that kind of drawing, including PDFs with no text layer, rotated sheets and colour-keyed layouts.</p>
      </div>
      <div class="reads-grid">
        {readsList.map(group => <article><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}
      </div>
      <div class="formats" aria-label="Supported inputs">{formats.map(format => <span>{format}</span>)}</div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap split top">
      <div>
        <span class="kicker">Trade coverage</span>
        <div class="section-head" style="margin-bottom:24px">
          <h2>Mapped to NRM2, <em>trade by trade.</em></h2>
          <p>Work is organised by the NRM2 work sections your bills already use. We publish the status of every section, including the ones we haven’t built yet.</p>
        </div>
        <div class="coverage-bar" role="img" aria-label={`${coverageCounts.measures} sections measured, ${coverageCounts.review} read and flagged, ${coverageCounts.roadmap} on the roadmap`}>
          <i class="m" style={`width:${pct(coverageCounts.measures)}`}></i><i class="r" style={`width:${pct(coverageCounts.review)}`}></i><i class="p" style={`width:${pct(coverageCounts.roadmap)}`}></i>
        </div>
        <div class="coverage-legend">
          <span><span class="chip chip-measures">Measures</span> <b>{coverageCounts.measures}</b></span>
          <span><span class="chip chip-review">Reads and flags</span> <b>{coverageCounts.review}</b></span>
          <span><span class="chip chip-roadmap">Roadmap</span> <b>{coverageCounts.roadmap}</b></span>
        </div>
        <p style="margin-top:32px"><a class="btn btn-acid" href="/coverage/">See all {coverageCounts.total} work sections</a></p>
      </div>
      <div class="cov-mini">
        {showcaseSections.map(section => <div><span><small>{section.code}</small>{section.name}</span><span class="chip chip-measures">Measures</span></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Who it’s for</span>
        <h2>For the people who price the work.</h2>
      </div>
      <div class="cards-3">
        {audiences.map(item => <article class="card"><span class="tag">{item.tag}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section dark tight">
    <div class="wrap split">
      <div>
        <span class="kicker">Security by design</span>
        <div class="section-head" style="margin-bottom:0">
          <h2>Your drawings stay on <em>your</em> machine.</h2>
          <p>BOQ Extract is a Windows desktop application. Tender packs are processed locally and offline: no uploads, no shared cloud, and no paid AI service reading your clients’ documents.</p>
        </div>
        <p style="margin-top:28px"><a class="text-link" href="/security/">How we handle your data →</a></p>
      </div>
      <ul class="tick-list">
        <li>Local, offline processing on a computer you control</li>
        <li>No external AI keys needed. Optional providers stay off by default</li>
        <li>Named accounts with separate operator, reviewer and certifier roles</li>
        <li>Every run snapshotted, so a bill can be traced back to exactly what produced it</li>
        <li>Private deployment available for organisations with strict IT controls</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split top">
      <div>
        <span class="kicker">International</span>
        <div class="section-head" style="margin-bottom:0">
          <h2>Built in the UK. Measured to the standard you work in.</h2>
          <p>Each project carries a locale profile: the measurement standard, currency and review requirements are set at the start and printed on every issue sheet and workbook.</p>
        </div>
      </div>
      <div class="dark" style="background:var(--ink);color:#fff;border-radius:20px;padding:8px 20px">
        <div class="table-scroll">
          <table class="locale-table">
            <thead><tr><th>Region</th><th>Standard</th><th>Currency</th></tr></thead>
            <tbody>{locales.map(item => <tr><td>{item.region}</td><td>{item.standard}</td><td class="mono">{item.currency}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="muted" style="font-size:13.5px;padding:14px 0 12px">Outside the UK, a locally qualified QS sets and certifies the applicable standard. Working elsewhere? <a href="/contact/" style="color:var(--acid)">Tell us where.</a></p>
      </div>
    </div>
  </section>

  <section class="section tight alt">
    <div class="wrap">
      <div class="pledge">
        <div>
          <span class="kicker">Our accuracy policy</span>
          <h2>We don’t publish accuracy we haven’t proven.</h2>
        </div>
        <div>
          <p>Many takeoff tools quote headline accuracy figures. We don’t, until an independent, RICS-registered quantity surveyor has certified our results on real projects, work section by work section.</p>
          <p style="margin-top:14px">Until then, every line comes with its evidence, and our pilots measure us against bills you have already priced.</p>
          <p style="margin-top:22px"><a class="text-link" href="/trust/">How we prove it →</a></p>
        </div>
      </div>
    </div>
  </section>
</ProductLayout>
