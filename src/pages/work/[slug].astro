---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import { projects, site } from '../../data/site'
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })) }
const { project } = Astro.props
const schema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: project.name,
  description: project.summary, url: `${site.url}/work/${project.slug}/`, image: new URL(project.logo, site.url).toString(), creator: { '@id': `${site.url}/#organisation` },
}
---
<SiteLayout title={`${project.name} Case Study | Twin Tech-sudo`} description={project.summary} schema={schema}>
  <SiteHeader /><main>
    <section class="case-hero" style={`--case:${project.colour}`}><div><span class="page-kicker">// {project.category.toUpperCase()}</span><h1>{project.name}</h1><p>{project.summary}</p></div><div class="case-device"><span>PROJECT / PRODUCT EXPERIENCE</span><img src={project.logo} alt={`${project.name} logo`} /><i></i><i></i><i></i></div></section>
    <section class="page-section case-story"><article><span>01 / CHALLENGE</span><h2>The problem</h2><p>{project.challenge}</p></article><article><span>02 / RESPONSE</span><h2>The product direction</h2><p>{project.solution}</p></article></section>
    <section class="dark-panel case-capabilities">
      <div><span class="page-kicker">// CAPABILITIES</span><h2>What the work<br /><em>brings together.</em></h2><p>Select a capability to see its role in the project.</p></div>
      <div class="compact-accordion dark-accordion">{project.capabilities.map((item, index) => <details name={`project-capabilities-${project.slug}`} open={index === 0}><summary><span>0{index + 1}</span><h3>{item.title}</h3><b><em class="show-label">Expand</em><em class="hide-label">Collapse</em><i>+</i></b></summary><p>{item.detail}</p></details>)}</div>
    </section>
    <aside class="evidence-note"><strong>Evidence, not theatre.</strong><p>{project.note}</p></aside>
  </main><SiteFooter />
</SiteLayout>
<script>
  document.querySelectorAll<HTMLElement>('.compact-accordion').forEach(group => {
    const items = group.querySelectorAll<HTMLDetailsElement>('details')
    items.forEach(item => item.addEventListener('toggle', () => {
      if (!item.open) return
      items.forEach(other => { if (other !== item) other.open = false })
    }))
  })
</script>
