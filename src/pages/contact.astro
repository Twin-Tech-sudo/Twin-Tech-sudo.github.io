---
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { site } from '../data/site'
---
<SiteLayout title="Start a Software Project | Contact Twin Tech-sudo" description="Discuss a custom software, web, mobile, desktop, e-commerce or AI automation project with Twin Tech-sudo in the UK.">
  <SiteHeader /><main class="contact-page"><section><span class="page-kicker">// START A PROJECT</span><h1>Bring the difficult<br /><em>problem.</em></h1><p>Tell us what is slowing the business down, what you want to make possible and where you are in the process. You do not need a finished specification.</p><div class="contact-direct"><span>Prefer email?</span><a href={`mailto:${site.email}?subject=Project enquiry for Twin Tech-sudo`}>{site.email} ↗</a><small>United Kingdom · working nationwide</small></div></section>
  <form class="enquiry-form" action={`mailto:${site.email}`} method="post" enctype="text/plain"><label>Your name<input required name="name" autocomplete="name" /></label><label>Email address<input required type="email" name="email" autocomplete="email" /></label><label>Company <span>Optional</span><input name="company" autocomplete="organization" /></label><label>What do you want to create?<select name="service"><option>Custom software</option><option>Web application</option><option>Mobile app</option><option>Desktop app</option><option>Website</option><option>E-commerce</option><option>AI & automation</option><option>Not sure yet</option></select></label><label class="full">Tell us about the problem<textarea required name="message" rows="7" placeholder="What happens today, and what would better look like?"></textarea></label><p class="full form-privacy">Your details are used to respond to this enquiry and discuss requested services. Read the <a href="/privacy/">privacy notice</a>.</p><button type="submit">Send project enquiry ↗</button><p>This opens your email app, so the website itself does not store your message.</p></form></main>
</SiteLayout>
