---
import ProductLayout from '../layouts/ProductLayout.astro'
import PageHead from '../components/PageHead.astro'
import EnquiryForm from '../components/EnquiryForm.astro'
import { site } from '../data/site'
---
<ProductLayout title="Contact | BOQ Extract" description="Talk to the BOQ Extract team about pilots, design partner places, private deployment, partnerships or using BOQ Extract outside the UK." cta={false}>
  <PageHead kicker="Contact" title="Let’s talk about" accent="the work you price." intro="Pilots, partnerships, security questions or using BOQ Extract in another country: send us a note and a person will reply." />
  <section class="section alt">
    <div class="wrap split top">
      <div class="contact-aside">
        <div><strong>Pilots and design partners</strong><p>Test BOQ Extract on packs you have already priced. <a class="text-link" href="/pilot/">See pilot options</a></p></div>
        <div><strong>Security and IT</strong><p>Questionnaires and data-handling reviews answered in writing.</p></div>
        <div><strong>International</strong><p>UK, Ireland and GCC profiles today. Tell us where else you work.</p></div>
        {site.email && <div><strong>Email</strong><p><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p></div>}
      </div>
      <EnquiryForm interest="General enquiry" />
    </div>
  </section>
</ProductLayout>
