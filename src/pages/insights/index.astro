---
import ProductLayout from '../../layouts/ProductLayout.astro'
import PageHead from '../../components/PageHead.astro'
import { articles, site } from '../../data/site'
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'BOQ Extract insights', itemListElement: articles.map((article, index) => ({ '@type': 'ListItem', position: index + 1, name: article.title, url: `${site.url}/insights/${article.slug}/` })) }
const format = (date: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`))
---
<ProductLayout title="Insights on Takeoff and Estimating | BOQ Extract" description="Practical guidance for quantity surveyors and estimators on automated takeoff, NRM2 and evaluating construction software fairly." schema={schema}>
  <PageHead kicker="Insights" title="Notes on measurement," accent="automation and trust." intro="Practical thinking for quantity surveyors, estimators and commercial teams weighing up automated takeoff." />
  <section class="section alt">
    <div class="wrap article-list">
      {articles.map(article => <a href={`/insights/${article.slug}/`}><div class="meta"><span>{article.category}</span><span>{article.read}</span></div><h2>{article.title}</h2><p>{article.description}</p><div class="meta"><time datetime={article.date}>{format(article.date)}</time></div></a>)}
    </div>
  </section>
</ProductLayout>
