---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import { articles, site } from '../../data/site'
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Twin Tech-sudo digital product insights', itemListElement: articles.map((article, index) => ({ '@type': 'ListItem', position: index + 1, name: article.title, url: `${site.url}/insights/${article.slug}/` })) }
---
<SiteLayout title="Digital Product & Software Insights | Twin Tech-sudo" description="Practical guidance on product strategy, custom software, experience design and responsible AI from Twin Tech-sudo." schema={schema}>
  <SiteHeader /><main><PageHero kicker="INSIGHTS" title="Useful thinking." accent="No filler." intro="Practical guidance for making better product, design and technology decisions before they become expensive." index="04" />
  <section id="content" class="page-section article-grid">{articles.map((article, index) => <a href={`/insights/${article.slug}/`}><div><span>0{index + 1}</span><b>{article.category}</b></div><h2>{article.title}</h2><p>{article.description}</p><footer><time datetime={article.date}>{new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${article.date}T00:00:00Z`))}</time><span>{article.read} →</span></footer></a>)}</section></main><SiteFooter />
</SiteLayout>
