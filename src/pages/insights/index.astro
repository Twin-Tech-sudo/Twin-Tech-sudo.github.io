---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import { articles } from '../../data/site'
---
<SiteLayout title="Construction Automation & Software Insights | Twin Tech-sudo" description="Practical guidance on construction document automation, custom software, product planning and responsible AI from Twin Tech-sudo.">
  <SiteHeader /><main><PageHero kicker="INSIGHTS" title="Useful thinking." accent="No filler." intro="Practical guidance for improving document-heavy workflows and making better product decisions before they become expensive." index="04" />
  <section id="content" class="page-section article-grid">{articles.map((article, index) => <a href={`/insights/${article.slug}/`}><div><span>0{index + 1}</span><b>{article.category}</b></div><h2>{article.title}</h2><p>{article.description}</p><footer><time datetime={article.date}>{new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${article.date}T00:00:00Z`))}</time><span>{article.read} →</span></footer></a>)}</section></main><SiteFooter />
</SiteLayout>
