---
import ProductLayout from '../../layouts/ProductLayout.astro'
import { articles, site } from '../../data/site'
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })) }
const { article } = Astro.props
type Section = { title: string; body: string[]; points?: string[] }
const copy: Record<string, { intro: string; sections: Section[] }> = {
  'evidence-linked-bill-of-quantities': {
    intro: 'A bill of quantities is a set of claims about a building. Each line says: this much of this thing, measured this way. When a line carries no record of where it came from, the only way to check it is to measure it again, which is exactly the work the bill was meant to save.',
    sections: [
      { title: 'The cost of an untraceable quantity', body: ['Most bills are built in spreadsheets and takeoff tools that keep the number and lose the reasoning. That is fine until someone asks. A main contractor queries a subcontractor’s partition total. A client’s QS challenges a variation. A colleague picks up a half-finished takeoff.', 'Each time, the answer is the same: open the drawings and start again. The checking costs nearly as much as the measuring.'] },
      { title: 'What evidence-linking means', body: ['An evidence-linked line keeps its working attached. At minimum that means the source sheet, the location on that sheet, the schedule row or legend key that defined the item, and the method used to turn the drawing into a quantity.'], points: ['Sheet and revision the quantity was taken from', 'Where on the sheet: grid reference, room or mark', 'The definition: schedule row, partition type key, finish legend', 'The method: centre-line length, net area, count of tagged symbols'] },
      { title: 'Why it matters more with automation', body: ['When software produces quantities, evidence stops being a nice-to-have. A reviewer cannot sensibly approve hundreds of machine-generated lines on trust. They need to see, for each one, what the software looked at.', 'Evidence also changes what review is. Instead of re-measuring, the surveyor checks the reasoning: is this the right partition type, is this enlargement being counted twice, does the schedule agree with the plan? That is the judgement work surveyors are trained for.'] },
      { title: 'Judgement calls belong to people', body: ['Some quantities depend on decisions the drawings do not make: formwork to a slab edge that sits on a ground beam, a deduction for deck troughs, which of two conflicting schedules is current. A trustworthy system raises these explicitly, with both sources shown, rather than picking one quietly.'] },
    ],
  },
  'automated-takeoff-nrm2': {
    intro: 'NRM2 gives UK quantity surveyors a shared structure for measuring building work. For automated takeoff it is also a useful discipline: it says what should be measured, in what unit and in what order, which makes it clear where software can do the work and where a surveyor has to decide.',
    sections: [
      { title: 'Work sections give automation a target', body: ['Organising output by work section means an automated draft lands in a shape the surveyor already recognises. It also makes coverage measurable: for each section you can say whether the software measured it, found it but needs help, or doesn’t yet read it.', 'That last category matters. A tool that is silent about a work section can look the same as a tool that found nothing to measure. Coverage should be explicit.'] },
      { title: 'What software does well', body: ['The repetitive, rule-following parts of measurement suit software best: counting tagged symbols, reading schedules row by row, tracing partition runs by type, summing room areas from finish legends, and following pipe and duct runs by system.'], points: ['Counts from schedules and plan marks', 'Lengths of runs by type or system', 'Areas from room outlines and finish keys', 'Cross-checking plan marks against schedules'] },
      { title: 'What should stay with the surveyor', body: ['Measurement rules leave room for interpretation, and drawings are often incomplete or contradictory. Software should surface these as questions, not answer them invisibly.'], points: ['Choosing between conflicting sources', 'Deductions and allowances that depend on convention', 'Whether an item is in scope or by others', 'Provisional sums and items with no drawn quantity'] },
      { title: 'Beyond the UK', body: ['Other countries use their own detailed measurement methods. A tool used internationally should record which standard applies to each project, and leave the local, qualified surveyor to set and certify it, rather than claiming compliance it has not earned.'] },
    ],
  },
  'running-a-takeoff-pilot': {
    intro: 'Demonstrations of takeoff software are usually run on drawings chosen by the vendor. The only test that tells you whether a tool will work for your business is one run on your own projects, compared with bills you already trust.',
    sections: [
      { title: 'Use packs you have already priced', body: ['Pick two or three completed tenders with the bill you produced for each. Those bills are your benchmark. Include at least one awkward pack: poor scans, several practices, services drawings, because that is what real tenders look like.'] },
      { title: 'Decide what you are measuring before you start', body: ['Agree up front which work sections matter to your business and what tolerance you would accept. Score by work section, not overall: a tool can be excellent on doors and ironmongery and unusable on roof coverings, and an average hides that.'], points: ['Lines found versus lines in your bill', 'Quantity difference per line, within your tolerance', 'Items the tool missed entirely', 'Items it billed that should not be there'] },
      { title: 'Time the review, not just the run', body: ['Processing speed is rarely the bottleneck. What matters is how long it takes a surveyor to get from the draft to a bill they would sign. Evidence on each line should make that review faster; if checking still means re-measuring, the time saving is mostly illusory.'] },
      { title: 'Protect your data and your clients’', body: ['Find out where your drawings go. Ask whether processing happens on your machine or a vendor’s servers, whether third-party AI services see the documents, and what is kept after the pilot. Get the answers in writing.'] },
      { title: 'Ask how accuracy claims were made', body: ['If a vendor quotes an accuracy figure, ask on which projects, which trades, against what benchmark, and who checked it. A claim certified by an independent surveyor on held-out projects means something. A single headline percentage usually does not.'] },
    ],
  },
}
const body = copy[article.slug]
const published = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${article.date}T00:00:00Z`))
const articleUrl = `${site.url}/insights/${article.slug}/`
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.description, datePublished: article.date, dateModified: article.date, mainEntityOfPage: articleUrl, image: `${site.url}/boqextract-social.png`, author: { '@id': `${site.url}/#organisation` }, publisher: { '@id': `${site.url}/#organisation` } }
---
<ProductLayout title={article.seoTitle} description={article.description} schema={schema}>
  <article class="insight">
    <header><a href="/insights/">← All insights</a><span class="page-kicker">{article.category.toUpperCase()}</span><h1>{article.title}</h1><p>{article.description}</p><div><time datetime={article.date}>{published}</time><span>{article.read}</span></div></header>
    <div class="insight-body">
      <p class="insight-intro">{body.intro}</p>
      {body.sections.map((section, index) => <section><span>0{index + 1}</span><h2>{section.title}</h2>{section.body.map(paragraph => <p>{paragraph}</p>)}{section.points && <ul>{section.points.map(point => <li>{point}</li>)}</ul>}</section>)}
      <div class="related"><b>See it on your own drawings.</b><a class="btn btn-acid" href="/pilot/">Explore the pilot programme</a></div>
    </div>
  </article>
</ProductLayout>
