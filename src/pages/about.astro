---
import SiteLayout from '../layouts/SiteLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import PageHero from '../components/PageHero.astro'

const principles = [
  {
    title: 'Product thinking included',
    detail: 'The brief is challenged and sharpened before code turns assumptions into expense. We connect the commercial goal, user need and delivery constraints so the first release solves a defined problem instead of simply reproducing an initial feature list.',
    includes: ['Clarify the outcome and audience', 'Challenge costly assumptions early', 'Prioritise the smallest useful release', 'Define evidence of success'],
  },
  {
    title: 'Build quality visible',
    detail: 'Working releases, plain-English decisions and evidence replace agency theatre. You can inspect progress throughout the build, understand important trade-offs and see quality demonstrated through the product rather than hidden behind status reports.',
    includes: ['Frequent working-product reviews', 'Clear technical decisions and trade-offs', 'Testing and release evidence', 'Visible progress against priorities'],
  },
  {
    title: 'Made to be maintained',
    detail: 'Clear systems, documentation and ownership matter after the first release. Architecture, code and operational choices are made with future change in mind so the product can be understood, supported and extended without avoidable dependency.',
    includes: ['Readable, structured source code', 'Documented setup and key decisions', 'Reliable deployment and monitoring', 'A practical route for future development'],
  },
  {
    title: 'Direct collaboration',
    detail: 'The person in the conversation is close to the design and the engineering. That shortens feedback loops, reduces translation between disciplines and keeps product, design and technical decisions connected to the real business objective.',
    includes: ['Direct access to the builder', 'Fast, focused feedback loops', 'Fewer layers and hand-offs', 'Shared ownership of key decisions'],
  },
]
---
<SiteLayout title="About Twin Tech-sudo | Independent UK Software Studio" description="Twin Tech-sudo is an independent UK software development studio combining product strategy, interface design and hands-on engineering.">
  <SiteHeader /><main><PageHero kicker="ABOUT TWIN TECH-SUDO" title="Senior thinking." accent="Builder energy." intro="A hands-on UK software development studio for founders and businesses that value momentum, craft and honest technical thinking." index="01" />
  <section id="content" class="page-section about-story"><div><span class="page-kicker">// THE STUDIO</span><h2>One continuous line from<br />ambition to <em>working product.</em></h2></div><div><p class="large-copy">Twin Tech-sudo exists to close the gap between a polished idea and software that genuinely works in the real world.</p><p>You work directly with the person shaping and building the product. That creates tighter feedback, fewer hand-offs and technology choices made around the actual goal—not a sales deck.</p></div></section>
  <section class="page-section principle-section" aria-labelledby="principles-title">
    <div class="principle-section-intro"><span class="page-kicker">// HOW THE STUDIO WORKS</span><h2 id="principles-title">Four principles behind<br /><em>every engagement.</em></h2><p>Select a principle to see what it means in practice.</p></div>
    <div class="feature-list principle-accordion">{principles.map((item, index) => <details name="studio-principles" open={index === 0}><summary><span>0{index + 1}</span><h3>{item.title}</h3><b class="feature-toggle"><em class="show-label">Expand details</em><em class="hide-label">Collapse details</em><i aria-hidden="true">+</i></b></summary><div class="feature-detail"><p>{item.detail}</p><div><b>In practice</b><ul>{item.includes.map(include => <li>{include}</li>)}</ul></div></div></details>)}</div>
  </section>
  </main><SiteFooter />
</SiteLayout>
<script>
  const principleItems = document.querySelectorAll<HTMLDetailsElement>('.principle-accordion details')
  principleItems.forEach(item => item.addEventListener('toggle', () => {
    if (!item.open) return
    principleItems.forEach(other => { if (other !== item) other.open = false })
  }))
</script>
