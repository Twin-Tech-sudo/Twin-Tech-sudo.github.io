---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import { services } from '../../data/site'
import { site } from '../../data/site'
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Twin Tech-sudo software development services', itemListElement: services.map((service, index) => ({ '@type': 'ListItem', position: index + 1, name: service.title, url: `${site.url}/services/${service.slug}/` })) }
---
<SiteLayout title="All Software Development Services UK | Twin Tech-sudo" description="Twin Tech-sudo designs and builds custom software, SaaS, web applications, mobile apps, desktop software, websites, e-commerce and practical AI products." schema={schema}>
  <SiteHeader />
  <main>
    <PageHero kicker="ALL-SOFTWARE PRODUCT STUDIO" title="One studio." accent="Every screen." intro="Custom software, SaaS, web, mobile, desktop, websites, commerce and AI—supported by product strategy, experience design and dependable engineering." index="07" />
    <section id="content" class="page-section service-index">
      <div class="section-intro"><span class="page-kicker">// WHAT WE BUILD</span><h2>Choose the capability.<br />Keep the thinking <em>connected.</em></h2><p>Each service can stand alone or combine into one product engagement. You work directly with the builder, with clear decisions and visible progress throughout.</p></div>
      <div class="page-card-grid">
        {services.map(service => <a class="page-card" href={`/services/${service.slug}/`}><span>{service.number}</span><div class="card-pulse"><i></i><b>{service.shortTitle.slice(0, 2).toUpperCase()}</b></div><h3>{service.title}</h3><p>{service.description}</p><strong>Explore capability →</strong></a>)}
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
