---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import PageHero from '../../components/PageHero.astro'
import { services } from '../../data/site'
---
<SiteLayout title="Construction Automation & Software Services UK | Twin Tech-sudo" description="Explore construction document automation, custom software, web, mobile, desktop, website, e-commerce and practical AI services in the UK.">
  <SiteHeader />
  <main>
    <PageHero kicker="CONSTRUCTION & SOFTWARE SERVICES" title="One workflow." accent="The right form." intro="Start with construction document automation or combine strategy, design and engineering into a dependable digital product." index="08" />
    <section id="content" class="page-section service-index">
      <div class="section-intro"><span class="page-kicker">// WHAT WE BUILD</span><h2>Choose the capability.<br />Keep the thinking <em>connected.</em></h2><p>Each service can stand alone or combine into one product engagement. You work directly with the builder, with clear decisions and visible progress throughout.</p></div>
      <div class="page-card-grid">
        {services.map(service => <a class="page-card" href={`/services/${service.slug}/`}><span>{service.number}</span><div class="card-pulse"><i></i><b>{service.shortTitle.slice(0, 2).toUpperCase()}</b></div><h3>{service.title}</h3><p>{service.description}</p><strong>Explore capability →</strong></a>)}
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
