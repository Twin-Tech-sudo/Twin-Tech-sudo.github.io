---
import '../styles.css'
import '../styles/pages.css'
import '../styles/mobile-hero.css'
import { site } from '../data/site'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  schema?: Record<string, unknown> | Record<string, unknown>[]
}

const { title = site.defaultTitle, description = site.defaultDescription, image = '/twin-tech-social.webp', noindex = false, schema } = Astro.props
const canonical = new URL(Astro.url.pathname, site.url)
const socialImage = new URL(image, site.url)
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID
const pathParts = Astro.url.pathname.split('/').filter(Boolean)
const labelOverrides: Record<string, string> = {
  insights: 'Insights', services: 'Services', work: 'Work', about: 'About',
  contact: 'Contact', process: 'Process', privacy: 'Privacy', cookies: 'Cookies', terms: 'Terms',
  'custom-software-development': 'Custom Software Development',
  'web-application-development': 'Web Application Development',
  'mobile-app-development': 'Mobile App Development',
  'desktop-app-development': 'Desktop App Development',
  'website-development': 'Website Design and Development',
  'ecommerce-development': 'E-commerce Development',
  'ai-automation': 'AI and Workflow Automation',
  boqextract: 'BOQExtract', 'macks-packs': "Mack's Packs",
}
const breadcrumb = pathParts.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    ...pathParts.map((part, index) => ({
      '@type': 'ListItem', position: index + 2,
      name: labelOverrides[part] || part.split('-').map(word => word[0]?.toUpperCase() + word.slice(1)).join(' '),
      item: new URL(`/${pathParts.slice(0, index + 1).join('/')}/`, site.url).toString(),
    })),
  ],
} : null
const organisation = {
  '@context': 'https://schema.org', '@type': ['Organization', 'ProfessionalService'], '@id': `${site.url}/#organisation`,
  name: site.name, ...(site.legalName ? { legalName: site.legalName } : {}), url: site.url,
  logo: `${site.url}/twin-tech-sudo-mark-256.png`,
  ...(site.email ? { email: site.email, contactPoint: { '@type': 'ContactPoint', email: site.email, contactType: 'sales', availableLanguage: 'English' } } : {}),
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  knowsAbout: ['Digital product strategy', 'Experience design', 'Custom software development', 'SaaS development', 'Web application development', 'Mobile application development', 'Desktop application development', 'Website development', 'E-commerce development', 'AI automation'],
}
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: site.url, publisher: { '@id': `${site.url}/#organisation` } }
const jsonLd = [organisation, website, ...(breadcrumb ? [breadcrumb] : []), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])]
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#0a0b0d" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="icon" type="image/png" sizes="256x256" href="/twin-tech-sudo-mark-256.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Twin Tech-sudo Insights" href="/rss.xml" />
    {jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <slot />
    {gaId && <div class="consent-banner" data-consent-banner hidden role="dialog" aria-label="Analytics cookie choices"><div><strong>Optional analytics</strong><p>Help improve this site with Google Analytics usage data. Nothing non-essential loads until you accept.</p><a href="/cookies/">Cookie details</a></div><div><button type="button" data-consent-reject>Decline</button><button type="button" data-consent-accept>Accept analytics</button></div></div>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      const key = 'twin-analytics-consent'
      const banner = document.querySelector('[data-consent-banner]')
      const loadAnalytics = () => {
        if (document.querySelector('script[src*="googletagmanager.com/gtag/js"]')) return
        const script = document.createElement('script'); script.async = true; script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`; document.head.appendChild(script)
        window.dataLayer = window.dataLayer || []; window.gtag = function(){ window.dataLayer.push(arguments) }; window.gtag('js', new Date()); window.gtag('config', gaId, { anonymize_ip: true })
      }
      const choice = localStorage.getItem(key)
      if (choice === 'accepted') loadAnalytics()
      else if (!choice && banner) banner.hidden = false
      banner?.querySelector('[data-consent-accept]')?.addEventListener('click', () => { localStorage.setItem(key, 'accepted'); banner.hidden = true; loadAnalytics() })
      banner?.querySelector('[data-consent-reject]')?.addEventListener('click', () => { localStorage.setItem(key, 'declined'); banner.hidden = true })
      document.querySelectorAll('[data-cookie-settings]').forEach(button => button.addEventListener('click', () => { if (banner) banner.hidden = false }))
    </script>}
  </body>
</html>
