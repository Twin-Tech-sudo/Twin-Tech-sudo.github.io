---
import { nav } from '../data/site'
const path = Astro.url.pathname
---
<header class="inner-header">
  <a class="brand" href="/" aria-label="Twin Tech-sudo home"><img src="/twin-tech-sudo-mark-256.webp" width="256" height="256" alt="" /><span>Twin Tech<span>-sudo</span></span></a>
  <nav aria-label="Main navigation">
    {nav.map(item => <a class={path.startsWith(item.href) ? 'active' : ''} href={item.href}>{item.label}</a>)}
    <a class="inner-cta" href="/contact/">Start a project ↘</a>
  </nav>
  <button class="inner-menu" aria-label="Open navigation" aria-expanded="false">Menu</button>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.inner-menu')
  const nav = document.querySelector<HTMLElement>('.inner-header nav')
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false
    button.setAttribute('aria-expanded', String(open))
  })
</script>
