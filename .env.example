# Safe to expose: Supabase protects private rows with Auth and RLS.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public business identity. Change the site URL only after custom-domain DNS
# and hosting are ready. These values are rendered publicly; never add secrets.
PUBLIC_SITE_URL=https://twin-tech-sudo.github.io
PUBLIC_LEGAL_NAME=
PUBLIC_COMPANY_NUMBER=
PUBLIC_REGISTERED_OFFICE=
PUBLIC_COMPANY_JURISDICTION=England and Wales

# Optional analytics identifiers. Non-essential analytics must wait for consent.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
